# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used to answer questions about the current page
ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated list of allowed origins for the browser extension.
# "*" is fine for local development; lock this down before shipping.
CORS_ALLOW_ORIGINS=*

# Max characters of extracted page text sent to the model per request
MAX_PAGE_TEXT_CHARS=12000
