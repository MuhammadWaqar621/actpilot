# --- Primary chat provider: Azure OpenAI (vision-capable) ---
# Used first for every request, including screenshot analysis.
AZURE_LLM_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_LLM_API_KEY=your-azure-openai-key
AZURE_LLM_MODEL=gpt-4o-mini
AZURE_LLM_API_VERSION=2024-08-01-preview

# --- Fallback chat provider: Groq ---
# Used automatically if Azure returns a rate-limit error. Groq is text-only,
# so the page screenshot is dropped for requests answered by this fallback.
GROQ_API_KEY=gsk_your-groq-key
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Comma-separated list of allowed origins for the browser extension.
# "*" is fine for local development; lock this down before shipping.
CORS_ALLOW_ORIGINS=*

# Max characters of extracted page text sent to the model per request
MAX_PAGE_TEXT_CHARS=12000
