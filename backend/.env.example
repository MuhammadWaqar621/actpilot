# Which provider serves chat completions first - "azure" (default,
# recommended - vision-capable) or "groq" (text-only). Whichever is NOT
# primary is still used automatically as the fallback on a rate-limit
# error, as long as it's configured below.
LLM_PROVIDER=azure

# --- Azure OpenAI (vision-capable) ---
AZURE_LLM_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_LLM_API_KEY=your-azure-openai-key
AZURE_LLM_MODEL=gpt-4o-mini
AZURE_LLM_API_VERSION=2024-08-01-preview

# --- Groq (OpenAI-compatible API) ---
# Text-only - the page screenshot is dropped for requests answered by Groq.
GROQ_API_KEY=gsk_your-groq-key
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Comma-separated list of allowed origins for the browser extension.
# "*" is fine for local development; lock this down before shipping.
#
# Once deployed on Vercel: the real value you want here is
# chrome-extension://<extension-id> (and edge-extension://<extension-id> if
# published to the Edge Add-ons store too) - but <extension-id> is only
# assigned once the extension is loaded unpacked or published, so there's no
# real value to put here ahead of time. Set the actual
# CORS_ALLOW_ORIGINS env var in the Vercel project's dashboard (Settings ->
# Environment Variables) after you know the id, then redeploy - don't rely
# on this file's "*" default in production. See README.md's "Notes" section
# for why "*" is considered acceptable here even so (rate limiting, not
# CORS, is the actual access control).
CORS_ALLOW_ORIGINS=*

# Max characters of extracted page text sent to the model per request
MAX_PAGE_TEXT_CHARS=12000
